# 空港ウォッチ / 特別塗装機 DB の環境変数（テンプレート）
#
# このファイルを `.env` にコピーして値を埋める（`.env` は commit しない）。
#   cp env.example .env
#   export $(grep -v '^#' .env | xargs)
# Vercel では Project → Settings → Environment Variables に同じものを設定する。
#
# ※ 本来は `.env.example` という名前にしたいが、エージェントの権限設定で
#    `.env*` への書き込みが禁じられているため `env.example` としている。

# Supabase プロジェクトの URL（Project Settings → API → Project URL）
# 未設定なら lib/db.js が自動でモック（lib/liveries.js の 11 件）に切り替わる
SUPABASE_URL=

# anon public key。公開してよい。/api/config 経由でブラウザに渡す
SUPABASE_ANON_KEY=

# service_role key。サーバー専用。絶対にフロントへ出さない（承認・却下 API だけが使う）
SUPABASE_SERVICE_ROLE_KEY=

# 1 にすると SUPABASE_URL があってもモックで動く（ローカル開発・CI 用）
MOCK_DB=1

# 1 にするとモックのストアに「承認待ち」のダミー（塗装2件・写真2件・通報1件）を入れる。
# /admin.html を手で触るための材料。npm run dev が自動で付ける（テストでは付けない）
MOCK_SEED_PENDING=

# Google Identity Services（ログインボタン）のウェブ クライアント ID。公開してよい値で、
# /api/config 経由でブラウザに渡す（例: 1234567890-abcdef.apps.googleusercontent.com）。
# 作り方と Supabase 側の設定（Authorized Client IDs）は supabase/README.md の「3. 認証プロバイダ」。
# 未設定だと /login.html が「Google ログインが未設定です（GOOGLE_CLIENT_ID）」と表示する。
GOOGLE_CLIENT_ID=
