{
  "rewrites": [
    {
      "source": "/api/admin/:op",
      "destination": "/api/admin?op=:op"
    },
    {
      "source": "/livery/:reg",
      "destination": "/api/livery-page?reg=:reg"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
